---
import BaseLayout from '../layouts/BaseLayout.astro';
import Status from '../components/Status.astro';
const lang = 'en';
---
<BaseLayout lang={lang} title="Deployment — Plyten" description="The architecture is intended to support SaaS, private-cloud and on-premise profiles without incompatible product forks.">
  <section class="shell hero">
    <div><p class="eyebrow">Plyten</p><Status label="Direction" /></div>
    <h1>Deployment</h1>
    <p class="lede">The architecture is intended to support SaaS, private-cloud and on-premise profiles without incompatible product forks.</p>
  </section>
  <section class="shell"><article class="card"><h2>Current status</h2><p>This surface develops in parallel with the platform and will grow only with evidence-backed material.</p></article></section>
</BaseLayout>

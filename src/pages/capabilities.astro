---
import BaseLayout from '../layouts/BaseLayout.astro';
import Status from '../components/Status.astro';
const lang = 'en';
---
<BaseLayout lang={lang} title="Capabilities — Plyten" description="Capabilities arrive by horizons: safe ingestion and viewing, feedback, versions and releases, then intelligence and authoring.">
  <section class="shell hero">
    <div><p class="eyebrow">Plyten</p><Status label="Direction" /></div>
    <h1>Capabilities</h1>
    <p class="lede">Capabilities arrive by horizons: safe ingestion and viewing, feedback, versions and releases, then intelligence and authoring.</p>
  </section>
  <section class="shell"><article class="card"><h2>Current status</h2><p>This surface develops in parallel with the platform and will grow only with evidence-backed material.</p></article></section>
</BaseLayout>

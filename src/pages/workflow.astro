---
import BaseLayout from '../layouts/BaseLayout.astro';
import Status from '../components/Status.astro';
const lang = 'en';
---
<BaseLayout lang={lang} title="Workflow — Plyten" description="Plyten links source information, concepts, BIM, visualization, review, releases and the later project lifecycle.">
  <section class="shell hero">
    <div><p class="eyebrow">Plyten</p><Status label="Direction" /></div>
    <h1>Workflow</h1>
    <p class="lede">Plyten links source information, concepts, BIM, visualization, review, releases and the later project lifecycle.</p>
  </section>
  <section class="shell"><article class="card"><h2>Current status</h2><p>This surface develops in parallel with the platform and will grow only with evidence-backed material.</p></article></section>
</BaseLayout>

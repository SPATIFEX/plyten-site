---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Status from '../../components/Status.astro';
const lang = 'ru';
---
<BaseLayout lang={lang} title="Возможности — Plyten" description="Возможности вводятся по горизонтам: безопасная загрузка и просмотр, обратная связь, версии, выпуски, затем интеллект и проектирование.">
  <section class="shell hero">
    <div><p class="eyebrow">Plyten</p><Status label="Направление" /></div>
    <h1>Возможности</h1>
    <p class="lede">Возможности вводятся по горизонтам: безопасная загрузка и просмотр, обратная связь, версии, выпуски, затем интеллект и проектирование.</p>
  </section>
  <section class="shell"><article class="card"><h2>Текущий статус</h2><p>Эта поверхность развивается параллельно с платформой и будет пополняться только подтверждёнными материалами.</p></article></section>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Status from '../../components/Status.astro';
const lang = 'ru';
---
<BaseLayout lang={lang} title="Процесс — Plyten" description="Plyten связывает исходные данные, концепцию, BIM, визуализацию, проверку, выпуск и дальнейший жизненный цикл проекта.">
  <section class="shell hero">
    <div><p class="eyebrow">Plyten</p><Status label="Направление" /></div>
    <h1>Процесс</h1>
    <p class="lede">Plyten связывает исходные данные, концепцию, BIM, визуализацию, проверку, выпуск и дальнейший жизненный цикл проекта.</p>
  </section>
  <section class="shell"><article class="card"><h2>Текущий статус</h2><p>Эта поверхность развивается параллельно с платформой и будет пополняться только подтверждёнными материалами.</p></article></section>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Status from '../../components/Status.astro';
const lang = 'ru';
---
<BaseLayout lang={lang} title="Развёртывание — Plyten" description="Архитектура предусматривает SaaS, private cloud и on-premise профили без отдельной несовместимой кодовой ветки.">
  <section class="shell hero">
    <div><p class="eyebrow">Plyten</p><Status label="Направление" /></div>
    <h1>Развёртывание</h1>
    <p class="lede">Архитектура предусматривает SaaS, private cloud и on-premise профили без отдельной несовместимой кодовой ветки.</p>
  </section>
  <section class="shell"><article class="card"><h2>Текущий статус</h2><p>Эта поверхность развивается параллельно с платформой и будет пополняться только подтверждёнными материалами.</p></article></section>
</BaseLayout>

---
const { lang = 'en' } = Astro.props;
const isRu = lang === 'ru';
const prefix = isRu ? '/ru' : '';
const nav = [{"slug": "workflow", "en": "Workflow", "ru": "Процесс"}, {"slug": "capabilities", "en": "Capabilities", "ru": "Возможности"}, {"slug": "deployment", "en": "Deployment", "ru": "Развёртывание"}];
---
<header>
  <div class="shell topbar">
    <a class="brand" href={prefix || '/'}>PLYTEN</a>
    <nav aria-label={isRu ? 'Основная навигация' : 'Primary navigation'}>
      {nav.map((item) => <a href={`${prefix}/${item.slug}/`}>{isRu ? item.ru : item.en}</a>)}
      <a class="lang" href={isRu ? '/' : '/ru/'} aria-label={isRu ? 'English' : 'Русский'}>{isRu ? 'EN' : 'RU'}</a>
    </nav>
  </div>
</header>
